# Server Environment Variables
PORT=4000
NODE_ENV=development

# Database & Cache
MONGODB_URI=mongodb://localhost:27017/loop_dev
REDIS_URL=redis://localhost:6379

# Authentication
JWT_ACCESS_SECRET=loop_dev_access_secret_key_super_secure_32bytes_min
JWT_REFRESH_SECRET=loop_dev_refresh_secret_key_super_secure_32bytes_min
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# CORS & Frontend Origins
CLIENT_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info
